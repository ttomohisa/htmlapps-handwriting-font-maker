{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dependencies.schema.json",
  "title": "Embedded npm dependencies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dependencies"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "version",
          "license",
          "homepage",
          "assets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "homepage": {
            "type": "string",
            "minLength": 1
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "path"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "mime": {
                  "type": "string",
                  "minLength": 1
                },
                "stripSourceMapComment": {
                  "type": "boolean"
                },
                "compression": {
                  "enum": [
                    "none",
                    "gzip",
                    "auto"
                  ]
                }
              }
            }
          },
          "updates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "policy": {
                "enum": [
                  "patch",
                  "minor",
                  "major",
                  "manual"
                ]
              }
            }
          }
        }
      }
    }
  }
}
