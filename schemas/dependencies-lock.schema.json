{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dependencies-lock.schema.json",
  "title": "Embedded npm dependency lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dependencies"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "version",
          "tarballSha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "tarballSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "integrity": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
